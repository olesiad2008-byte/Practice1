class Vehicle:
    def get_description(self):
        # Базовый метод, который будут переопределять дочерние классы
        return "Это транспортное средство"

class Car(Vehicle):
    def get_description(self):
        return "Легковой автомобиль: 4 колеса, бензиновый двигатель."

class Bicycle(Vehicle):
    def get_description(self):
        return "Велосипед: 2 колеса, приводится в движение педалями."

class Airplane(Vehicle):
    def get_description(self):
        return "Самолет: 2 крыла, реактивные двигатели, летает."

