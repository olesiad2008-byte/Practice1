import datetime
from decimal import Decimal

# Константа формата даты
DATE_FORMAT = '%Y-%m-%d'

# Начальный словарь goods
goods = {
    'Пельмени Универсальные': [
        {'amount': Decimal('0.5'), 'expiration_date': datetime.date(2023, 7, 15)},
        {'amount': Decimal('2'), 'expiration_date': datetime.date(2023, 8, 1)},
    ],
    'Вода': [
        {'amount': Decimal('1.5'), 'expiration_date': None}
    ],
}


def add(items, title, amount, expiration_date=None):
    """
    Добавляет партию продукта в словарь items.
    """
    # Если передана строка с датой, преобразуем её в тип date
    if expiration_date:
        expiration_date = datetime.datetime.strptime(expiration_date, DATE_FORMAT).date()
    # Создаем словарь партии
    batch = {'amount': Decimal(str(amount)), 'expiration_date': expiration_date}
    # Если продукта еще нет в словаре, создаем для него пустой список
    if title not in items:
        items[title] = []
    # Добавляем партию в список продукта
    items[title].append(batch)

def add_by_note(items, note):
    """
    Разбирает текстовую строку и вызывает функцию add().
    Формат: "Название продукта Количество [Дата]"
    """
    parts = note.split()
    # Проверяем, содержит ли последняя часть дефисы (признак даты)
    if '-' in parts[-1]:
        expiration_date = parts[-1]
        amount = parts[-2]
        title = ' '.join(parts[:-2]) # Все, кроме последних двух
    else:
        expiration_date = None
        amount = parts[-1]
        title = ' '.join(parts[:-1]) # Все, кроме последнего
    add(items, title, amount, expiration_date)

def find(items, needle):
    """
    Ищет продукты по подстроке без учета регистра.
    """
    result = []
    needle_lower = needle.lower()
    for title in items:
        if needle_lower in title.lower():
            result.append(title)
    return result

def get_amount(items, needle):
    """
    Возвращает общее количество всех найденных продуктов.
    """
    total_amount = Decimal('0')
    found_titles = find(items, needle)
    for title in found_titles:
        for batch in items[title]:
            total_amount += batch['amount']       
    return total_amount

def get_expired(items, in_advance_days=0):
    """
    Возвращает список кортежей (название, общее количество) просроченных продуктов.
    """
    today = datetime.date.today()
    # Страховка: если платформа передала None вместо 0
    if in_advance_days is None:
        in_advance_days = 0
    check_date = today + datetime.timedelta(days=in_advance_days)
    expired_items = [] 
    for title, batches in items.items():
        # Переменная для накопления общего количества просроченного продукта
        total_expired_amount = Decimal('0')
        is_expired = False
        for batch in batches:
            exp_date = batch['expiration_date']
            # Если срок годности указан и он подошел к концу
            if exp_date is not None and exp_date <= check_date:
                # Прибавляем количество этой партии к общему
                total_expired_amount += batch['amount']
                is_expired = True     
        # Если хотя бы одна партия просрочена, добавляем продукт в итоговый список
        if is_expired:
            expired_items.append((title, total_expired_amount))       
    return expired_items


add(goods, 'Яйца', 10)
add(goods, 'Яйца', 5, '2025-12-31')
print("После добавления Яиц:", goods['Яйца'])


add_by_note(goods, 'Молоко 1.5 2023-10-10')
add_by_note(goods, 'Хлеб Бородинский 2')
print("Молоко:", goods['Молоко'])
print("Хлеб:", goods['Хлеб Бородинский'])


print("\nПоиск 'пельмени':", find(goods, 'пельмени'))
print("Поиск 'ВОДА':", find(goods, 'ВОДА'))


print("\nКоличество Пельменей:", get_amount(goods, 'Пельмени'))
print("Количество Яиц:", get_amount(goods, 'Яйца'))


yesterday = (datetime.date.today() - datetime.timedelta(days=1)).strftime(DATE_FORMAT)
add(goods, 'Просроченный кефир', 1, yesterday)
print("\nПросроченные продукты:", get_expired(goods))
