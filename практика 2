def int_to_roman(num):
    """
    Преобразует целое число в римскую запись.
    
    """
    # Значения римских чисел по убыванию (включая вычитательные формы)
    val = [
        1000, 900, 500, 400,
        100, 90, 50, 40,
        10, 9, 5, 4,
        1
    ]
    # Соответствующие римские символы
    syb = [
        "M", "CM", "D", "CD",
        "C", "XC", "L", "XL",
        "X", "IX", "V", "IV",
        "I"
    ]
    
    roman_num = ''   # сюда собираем результат
    i = 0            # индекс текущего римского числа
    
    # Пока в числе остались единицы — вычитаем наибольшее подходящее
    while num > 0:
        # Сколько раз val[i] помещается в num — столько раз пишем syb[i]
        for _ in range(num // val[i]):
            roman_num += syb[i]
            num -= val[i]
        i += 1
    
    return roman_num


def roman_to_int(s):
    """
    Преобразует римскую запись в целое число.
    """
    # Словарь: символ → значение
    roman_dict = {
        'I': 1, 'V': 5, 'X': 10, 'L': 50,
        'C': 100, 'D': 500, 'M': 1000
    }
    
    total = 0        # итоговая сумма
    prev_value = 0   # значение предыдущего (справа) символа
    
    # Идём по строке справа налево
    for char in reversed(s):
        value = roman_dict[char]
        
        # Если текущий меньше предыдущего справа — вычитаем
        if value < prev_value:
            total -= value
        else:
            total += value
        
        prev_value = value  # запоминаем для следующей итерации
    
    return total







