def print_pack_report(num):
    """
    Печатает отчёт о том, как расфасовать пирожные.
    
    Перебирает числа от num до 1 по убыванию и для каждого
    сообщает, можно ли его расфасовать по 3, по 5, или не заказывать.
    """
    
    for i in range(num, 0, -1):
        if i % 3 == 0 and i % 5 == 0:
            print(f"{i} - расфасуем по 3 или по 5")
        elif i % 5 == 0:
            print(f"{i} - расфасуем по 5")
        elif i % 3 == 0:
            print(f"{i} - расфасуем по 3")
        else:
            print(f"{i} - не заказываем!")




